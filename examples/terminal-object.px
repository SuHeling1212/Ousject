func main() {
    root = object.find("terminal")
    child_id = root.create()
    terminal = object.find(child_id)
    terminal.resize(48, 12)
    terminal.configure({input_mode: "raw", echo: false})
    terminal.foreground()

    time = object.find("time")
    banner = "\e[?1049h\e[?1h\e[?2004h\e[?1000h\e[?1006h"
    banner = banner + "\e[2J\e[1;1H\e[1;38;2;80;220;255mOusject Terminal\e[0m"
    banner = banner + "\e[3;1H256 colors; grapheme-aware cells"
    banner = banner + "\e[4;1HChild Terminal; true-color support"
    banner = banner + "\e[5;1HArrows: normal/application cursor keys"
    banner = banner + "\e[6;1HPaste and SGR mouse: Terminal.input()"
    banner = banner + "\e[8;1HPress r to test resize events"
    banner = banner + "\e[9;1HPress q to quit"
    terminal.output(banner.utf8_bytes())

    if terminal.is_interactive() {
        running = true
        while running {
            bytes = terminal.input(64)
            index = 0
            while index < #bytes {
                key = bytes[index]
                if key == 113 or key == 81 {
                    running = false
                } else if key == 114 {
                    notice = "\e[10;1HResize now; the Process is waiting for a Terminal event."
                    terminal.output(notice.utf8_bytes())
                    event = terminal.wait_event()
                    result_line = "\e[11;1HResize event delivered without polling.\e[K"
                    terminal.output(result_line.utf8_bytes())
                    terminal.output(event["kind"].utf8_bytes())
                    terminal.output("\n".utf8_bytes())
                }
                index++
            }
            if running {
                time.sleep(16)
            }
        }
    }

    cleanup = "\e[?1006l\e[?1000l\e[?2004l\e[?1l\e[?1049l\e[0m"
    terminal.output(cleanup.utf8_bytes())
}
