func twice(value) {
    return value * 2
}

class Counter {
    value = 0

    func add(amount) {
        this.value = this.value + amount
        return this.value
    }
}

func main() {
terminal = object.find("terminal")
counter = object.create("Counter", { value: twice(5) })
terminal.println(counter.add(2))
terminal.println(counter.type)
}
