func main() {
// Assignment creates a core.value Object; explicit creation chooses a Type.
x = 46
terminal = object.find("terminal")
note = object.create("core.text", "hello")
terminal.println(x.type)
terminal.println(note.type)
terminal.println(note)

note.replace("hello, Ousject")
same = object.find(note.id)
terminal.println(same.value)

root = object.create("core.namespace", {})
root.link("note", note)
linked = object.find(root.links["note"])
terminal.println(linked.value)
terminal.println(#object.query("core.text"))
terminal.println("printed by the terminal Object")
}
