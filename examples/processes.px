class Channel {
    value = 0
}

func worker() {
    channel = object.find("channel")
    channel.value++
}

func main() {
terminal = object.find("terminal")
channel = object.create("Channel", {})
child = object.create("core.process", {
    entry: "worker",
    links: { channel: channel.id }
})

child.start()
terminal.println(child.wait())
terminal.println(channel.value)
}
