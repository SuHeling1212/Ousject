class Channel {
    value = 0
}

func worker() {
    channel = object.find("channel")
    channel.value++
}

console = object.find("console")
channel = object.create("Channel", {})
child = object.create("core.process", {
    entry: "worker",
    links: { channel: channel.id }
})

child.start()
console.println(child.wait())
console.println(channel.value)
