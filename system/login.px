func main() {
terminal = object.find("terminal")
authentication = object.find("authentication")
programs = object.find("programs")

logged_in = false
while !logged_in {
    try {
        terminal.print("user: ")
        name = terminal.read_line()
        terminal.print("password: ")
        password = terminal.read_secret()
        session = authentication.login(name, password)
        terminal.println("logged in")
        terminal.println(session["subject"])
        logged_in = true
    } catch (error) {
        terminal.println(error)
    }
}

shell_id = programs.resolve("shell")
shell = object.find(shell_id)
shell_process_id = shell.execute()
shell_process = object.find(shell_process_id)
shell_status = shell_process.wait()
if shell_status == "failed" {
    terminal.println(shell_process.error)
}
}
