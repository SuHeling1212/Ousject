func main() {
terminal = object.find("terminal")
authentication = object.find("authentication")

initialized = false
while !initialized {
    try {
        terminal.print("Create the local password: ")
        password = terminal.read_secret()
        identity = authentication.initialize_local(password)
        terminal.println("local initialized")
        terminal.println(identity)
        initialized = true
    } catch (error) {
        terminal.println(error)
    }
}
}
